#include <windows.h> 

#if @IS_DEBUG@
#define VER_DEBUG VS_FF_DEBUG
#else 
#define VER_DEBUG 0
#endif

#if @IS_PRERELEASE@ 
#define VER_PRERELEASE VS_FF_PRERELEASE
#else
#define VER_PRERELEASE 0
#endif

#define VER_PRIVATEBUILD 0

//Configure Version Info
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS (VER_DEBUG|VER_PRERELEASE|VER_PRIVATEBUILD)
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0"  // Lang-charset (English - United Kingdom)
        BEGIN
            VALUE "CompanyName", "Ewan Burnett"
            VALUE "FileDescription", "@CONFIG_TARGET_DESCRIPTION@"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "@CONFIG_TARGET_NAME@"
            VALUE "OriginalFilename", "@CONFIG_TARGET_NAME@.exe"
            VALUE "ProductName", "@CONFIG_TARGET_NAME@"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200  // English (UK) Unicode
    END
END

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ICON1               ICON                    "@CONFIG_ICON_PATH@"